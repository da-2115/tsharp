// Statistics.tsharp
// T# standard library - to use: import std.math.Vector2
// Dylan Armstrong, 2026

class Statistics {
    public double mean(double values[]) {
        int n = size(values)

        if (n == 0) {
            return 0.0
        }

        double total = 0.0

        for (int i = 0; i < n; i++) {
            total += values[i]
        }

        return total / n
    }

    public double variance(double values[]) {
        int n = size(values)

        if (n == 0) {
            return 0.0
        }

        double average = this.mean(values)
        double sum = 0.0

        for (int i = 0; i < n; i++) {
            double difference = values[i] - average
            sum += difference * difference
        }

        return sum / n
    }

    public double sampleVariance(double values[]) {
        int n = size(values)

        if (n < 2) {
            return 0.0
        }

        double average = this.mean(values)
        double sum = 0.0

        for (int i = 0; i < n; i++) {
            double difference = values[i] - average
            sum += difference * difference
        }

        return sum / (n - 1)
    }

    public double standardDeviation(double values[]) {
        return sqrt(this.variance(values))
    }

    public double sampleStandardDeviation(double values[]) {
        return sqrt(this.sampleVariance(values))
    }

    public double covariance(double x[], double y[]) {
        int n = size(x)

        if (n == 0 || n != size(y)) {
            return 0.0
        }

        double meanX = this.mean(x)
        double meanY = this.mean(y)
        double sum = 0.0

        for (int i = 0; i < n; i++) {
            sum += (x[i] - meanX) * (y[i] - meanY)
        }

        return sum / n
    }

    public double correlation(double x[], double y[]) {
        double cov = covariance(x, y)
        double stdX = standardDeviation(x)
        double stdY = standardDeviation(y)

        if (stdX == 0.0 || stdY == 0.0) {
            return 0.0
        }

        return cov / (stdX * stdY)
    }
}

import std.collections.Dictionary

class NRootFinder {
    public () { }
    
    // Return first n root of x pair as a dictionary entry (T# pair equivalent)
    public DictionaryEntry<int, int> Result() {
        DictionaryEntry<int, int> result()
        
        double to_find = round(golden_ratio * 10000) / 10000

        for int i = 1; i < 10; i++ {
            for int j = 1; j < 100; j++ {
                double xrt = round(x_root(j, i) * 10000) / 10000
                if xrt == to_find {
                    result.key = j
                    result.value = i
                }
            }
        }
        
        return result
    }
}

void main() {
    NRootFinder nRootFinder()

    println("The " + nRootFinder.Result().value + "th root of " + 
        nRootFinder.Result().key + " approximately equals the golden ratio"
    )

    println("Test: " + x_root(nRootFinder.Result().key, nRootFinder.Result().value))
}
void main() {
    int count = 0

    for (int n = 2; n <= 100000; n++) {
        bool prime = true

        for (int d = 2; d * d <= n; d++) {
            if (n % d == 0) {
                prime = false
                break
            }
        }

        if (prime) {
            count++
        }
    }

    println(count)
}

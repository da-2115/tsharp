import std.math.Matrix3
import std.math.Vector3

void main() {
    Vector3<int> vecs[3] = { Vector3<int>(1, 2, 3), Vector3<int>(4, 5, 6), Vector3<int>(7, 8, 9) }

    Matrix3<int> M = matrix_from_vectors(vecs)

    println(M.to_string())
    println(M.transpose().to_string())
    println(M.add(Matrix3<T>( 5, 6, 8, 13, 12, 1, 2, 4, 19 )).to_string())
}